{
  "name": "wildblocks",
  "private": true,
  "version": "1.3.0",
  "description": "WildBlocks \u2014 A Tiny Living World. A cozy browser voxel adventure sandbox.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "docs:players": "tsx scripts/generate-player-guide.ts",
    "release": "node scripts/release.mjs",
    "realese": "npm run release",
    "validate:playgama": "node scripts/validate-playgama.mjs",
    "test:playgama": "playwright test tests/playgama",
    "preview:release": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@playgama/bridge": "2.3.1",
    "@react-three/fiber": "^9.8.1",
    "idb": "^8.0.3",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "0.8.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
